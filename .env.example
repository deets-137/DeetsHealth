# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
# Synthetic data only until every vendor's BAA is signed (SECURITY.md).
#
# Keys are made per machine, never copied (HANDOFF.md › On another machine):
# - Make a new key at each vendor for each machine, named for it ("deets-mac", "deets-pc").
#   A lost machine then costs only its own keys, and each vendor's usage shows which spent what.
# - Type each value into this machine's .env by hand. Never send one through a chat, a doc, a
#   commit, a sync folder or a password manager shared between machines.
# - `npm run env:check` says what this machine lacks. It prints names, never a value.
#
# The layout is read by scripts/env-check.mjs:
# - `# == <title> ==` starts a group. "(needed)" in the title: nothing works without it.
#   Otherwise the group turns a feature on, and the feature stays off without it.
# - A `NAME=` line is a value the group needs. A `# NAME=` line has a default in the code.
# - A value written here is a setting, not a secret. Every secret here is blank.

# == The Anthropic API (needed) ==
# The key from the "DeetsHealth Dev" workspace (Deets.Solutions organization), one per machine.
# Budget: the Max plan's $100 of API credit a month. Never more (BUILD-ORDER.md, Phase 1).
# Replay-only tests and `npm run check` need no key; a live call and Record and test do.
ANTHROPIC_API_KEY=
# Optional: the monthly budget the Resources tab counts against (default 100), and the day of
# the month the cycle starts (1 to 28, default 1).
# ANTHROPIC_BUDGET_USD=100
# ANTHROPIC_CYCLE_DAY=1

# == Voice calls (Cartesia) ==
# Ink and Sonic for voice test calls (CARTESIA.md). A Free account: synthetic audio only, no
# BAA. Without the key the Chat page's Voice is off; typed calls still work.
CARTESIA_API_KEY=
# Optional (CARTESIA.md §9): a voice id in place of the draft voice; the plan's credits a month
# (Free: 20000); the day of the month the credits renew (the day the account was opened).
# CARTESIA_VOICE_ID=
# CARTESIA_PLAN_CREDITS=20000
# CARTESIA_CYCLE_DAY=1

# Scribe and Flash, the second voice vendor (VOICE-VENDORS.md §11; chosen on Config › Voice). A
# Free account: synthetic audio only, no BAA; the free plan stops at its credits and never bills.
# `npx -y @elevenlabs/cli@latest onboard connect --env-path .env` writes the key here.
ELEVENLABS_API_KEY=
# Optional: a voice id in place of the draft voice (Sarah); the plan's credits a month (Free:
# 10000); the day of the month the credits renew.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_PLAN_CREDITS=10000
# ELEVENLABS_CYCLE_DAY=1

# == The demo over the tunnel ==
# docs/ops/DEMO.md §7. Only the one machine that runs the demo needs this group: the tunnel
# takes one connector, and `npm run dev` opens none when another machine already has it.
# The tunnel id is in `cf tunnels list`; its credentials file is ~/.cloudflared/<id>.json and
# stays on the machine that made it. The audience tag is on the Access app in Cloudflare.
DEETS_TUNNEL_ID=
DEETS_ACCESS_TEAM=deetssolutions.cloudflareaccess.com
DEETS_ACCESS_AUD=
DEETS_DEMO_ORIGIN=https://deetshealth.deets.solutions

# == Guests' voice in the demo (Cloudflare TURN) ==
# The TURN key (DEMO.md §7). Without it a guest can type but not speak.
DEETS_TURN_KEY_ID=
DEETS_TURN_API_TOKEN=

# == The Access group linked to Teams › People ==
# DEMO.md §7: a token with only "Access: Groups Write" and "Access: Organizations Revoke" on the
# account, one per machine. Without it the list still works in the store, and the page says
# Cloudflare is not linked.
DEETS_CF_API_TOKEN=
DEETS_CF_ACCOUNT_ID=
DEETS_ACCESS_GROUP_ID=

# == Real texts (Twilio) ==
# The code by text through Twilio (TEXTS.md). Not set up yet (Phase 5): without it `ehr` uses
# the fake code, and the dev server's fake Twilio covers the tests. Blank values are safe.
DEETS_TWILIO_ACCOUNT_SID=
DEETS_TWILIO_AUTH_TOKEN=
DEETS_TWILIO_MESSAGING_SERVICE=

# == This machine's overrides ==
# Optional. The folder that holds pg_ctl, when Postgres is not in a standard place
# (scripts/postgres.mjs); another `ehr` build, when a running dev server holds this one.
# DEETS_PG_BIN=
# DEETS_EHR_BIN=

# Never put these in .env: the scripts set them on each run. DEETS_DEV_TOKEN, DEETS_AGENT_PORT,
# DEETS_AGENT_TOKEN, DEETS_DATABASE_URL, DEETS_SEAL_KEY_FILE, DEETS_EPIC_SANDBOX,
# DEETS_EPIC_CLIENT_FILE, DEETS_EPIC_KEY_FILE. DEETS_REQUIRE_FIPS is for a deploy only.
#
# Secret files outside .env, also per machine (env:check looks for them):
# - dev-certs/ — `cargo run -p deetshealth-ehr --example dev_certs` makes them on each machine.
# - epic-client.json and dev-certs/epic-nonprod-es384.key — Epic's sandbox only (EPIC.md §5).
#   Make a new key pair on each machine and add its public key to the key set
#   (ehr/jwks-worker/src/nonprod.jwks.json); never copy the private key.
