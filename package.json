{
  "name": "deetshealth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p console && vite build console",
    "preview": "vite preview console",
    "tokens": "node scripts/tokens.mjs",
    "types": "node scripts/types.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "check": "node scripts/check.mjs",
    "check:all": "node scripts/check.mjs --all --full",
    "prepare": "git config core.hooksPath .githooks",
    "dev:web": "vite console",
    "db:start": "node scripts/postgres.mjs start",
    "db:stop": "node scripts/postgres.mjs stop",
    "db:status": "node scripts/postgres.mjs status",
    "db:ingest": "node scripts/postgres.mjs ingest",
    "db:test": "node scripts/postgres.mjs test",
    "env:check": "node scripts/env-check.mjs"
  },
  "devDependencies": {
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "@pipecat-ai/client-js": "^1.16.0"
  }
